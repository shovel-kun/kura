amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // ruff is run through `uv run` so the version comes from uv.lock
  // (the builtins invoke `ruff` from PATH with no version pinning).
  ["ruff"] {
    glob = "**/*.py"
    check = "uv run ruff check {{files}}"
    fix = "uv run ruff check --fix {{files}}"
  }
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["end-of-file-fixer"] = Builtins.newlines
  // No builtin honours --maxkb (the builtin defaults to 500KB), so keep a custom step.
  ["check-added-large-files"] {
    glob = "**/*"
    check = "hk util check-added-large-files --maxkb 1000 {{files}}"
  }
  ["check-json"] {
    glob = "**/*.json"
    check = "for f in {{files}}; do jq empty \"$f\" 2>/dev/null || { echo \"Invalid JSON: $f\"; exit 1; }; done"
  }
  ["check-toml"] {
    glob = "**/*.toml"
    check = "for f in {{files}}; do python3 -c 'import tomllib,sys; tomllib.load(open(sys.argv[1], \"rb\"))' \"$f\" 2>/dev/null || { echo \"Invalid TOML: $f\"; exit 1; }; done"
  }
  ["check-yaml"] {
    glob = "**/*.{yaml,yml}"
    check = "for f in {{files}}; do python3 -c \"import yaml; yaml.safe_load(open('$f'))\" 2>/dev/null || { echo \"Invalid YAML: $f\"; exit 1; }; done"
  }
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
}

local commitMessageLinters = new Mapping<String, Step> {
  // Custom step rather than Builtins.check_conventional_commit: the builtin
  // would reject `Merge ...` / `Revert "..."` subjects, which git generates.
  ["conventional-commit"] {
    check = "first_line=$(sed -n '1p' {{commit_msg_file}}); printf '%s\n' \"$first_line\" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([a-z0-9._-]+\\))?!?: .+' || printf '%s\n' \"$first_line\" | grep -Eq '^(Merge |Revert \")' || { echo \"Commit message must use Conventional Commits, e.g. fix(watch): parse ffmpeg downloader progress\"; echo \"Actual: $first_line\"; exit 1; }"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["pre-push"] {
    steps {
      ["pytest"] {
        glob = "**/*.py"
        check = "uv run pytest -q"
      }
    }
  }
  ["commit-msg"] {
    steps = commitMessageLinters
  }
  ["fix"] {
    fix = true
    stage = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
